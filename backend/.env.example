# ─── Database ────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://nerve_user:nerve_pass@localhost:5432/nerve_db

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# ─── Webhook ──────────────────────────────────────────────────────────────────
NERVE_WEBHOOK_SECRET=change-me-to-a-webhook-secret
